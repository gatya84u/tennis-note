<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- TODO ExpandableLayoutなどのライブラリ適用-->
    <TextView
        android:id="@+id/challenging_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/checklist_effort"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/complete_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/checklist_completed"
        app:layout_constraintTop_toBottomOf="@id/challenging_tasks"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>